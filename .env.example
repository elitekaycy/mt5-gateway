# Backend - MT5
CUSTOM_USER=
PASSWORD=
VNC_DOMAIN=vnc.example.com
API_DOMAIN=api.example.com

# MT5 API Configuration
MT5_API_PORT=5001
API_KEY=
CORS_ORIGINS=
KILL_SWITCH_FILE=/config/kill-switch

# Broker server clock, used to place GTD order expiries at the right instant. Leave
# everything unset: the offset is derived from the freshest quote in Market Watch at
# connect, from each GTD order's own symbol, and refreshed every 10 minutes (DST-safe).
# To pin it, prefer an IANA zone (follows DST) over a fixed seconds value.
# MT5_SERVER_TIME_ZONE=Europe/Athens
# MT5_SERVER_UTC_OFFSET_SECONDS=
# MT5_TIME_REFERENCE_SYMBOL=

# Swagger UI scheme configuration (default: http)
# Set to "https" for production deployments behind reverse proxy
SWAGGER_SCHEME=http

# MT5 Connection Settings
# Maximum attempts to reconnect to MT5 when connection is lost (default: 3)
MT5_RECONNECT_ATTEMPTS=3

# Base delay in seconds between reconnection attempts (uses exponential backoff, default: 1.0)
MT5_RECONNECT_BASE_DELAY=1.0

# Seconds a verified MT5 connection is trusted before ensure_connection()
# re-probes with a live account_info() call (default: 30). Set to 0 to probe on
# every request (previous behaviour). IPC-level call failures always mark the
# connection down immediately regardless of this TTL.
MT5_CONNECTION_VERIFY_TTL_SECONDS=30

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Traefik
TRAEFIK_DOMAIN=traefik.example.com
TRAEFIK_USERNAME=admin
ACME_EMAIL=admin@example.com

# ── Headless broker login (optional) ────────────────────────────────────────
# Set these and the gateway logs into the broker on boot — no VNC. Leave
# MT5_LOGIN empty to keep the manual VNC flow + persisted-volume login.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial9
MT5_ENABLE_ALGO_TRADING=1
MT5_SERVER_ADDR=
MT5_AUTORESOLVE=1
MT5_RESOLVER_URL=https://mt5.mtapi.io,http://mt5-resolver:80
MT5_SETUP_URL=
MT5_SETUP_SHA256=
MT5_SETUP_ATTEMPTS=3
MT5_SETUP_TIMEOUT=600

# servers.dat (the broker directory) ships baked into the image — for the major
# brokers you just set the three vars above. To override without rebuilding,
# mount your own at /defaults/servers.dat, or fetch from a private repo by
# setting the token below.
QKT_ARTIFACTS_TOKEN=
QKT_ARTIFACTS_REPO=elitekaycy/qkt-artifacts
QKT_ARTIFACTS_FILE=servers.dat
